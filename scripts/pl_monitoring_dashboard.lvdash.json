          },
          "position": {"x": 4, "y": 15, "width": 4, "height": 6}
        },
        {
          "widget": {
            "name": "target_dist",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_target_dist",
