                  "fields": [
                    {"name": "version", "expression": "`version`"},
                    {"name": "eval_rows", "expression": "`eval_rows`"},
                    {"name": "gini", "expression": "`gini`"},
                    {"name": "weighted_gini_by_dp3", "expression": "`weighted_gini_by_dp3`"},
                    {"name": "weighted_gini_by_pop", "expression": "`weighted_gini_by_pop`"},
