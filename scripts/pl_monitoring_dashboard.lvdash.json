                "name": "main_query",
                "query": {
                  "datasetName": "ds_risk_grade",
                  "fields": [
                    {"name": "risk_grade", "expression": "`risk_grade`"},
                    {"name": "n", "expression": "`n`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "risk_grade", "scale": {"type": "categorical"}, "displayName": "Risk grade"},
                "y": {"fieldName": "n", "scale": {"type": "quantitative"}, "displayName": "Applications"}
              },
              "frame": {"showTitle": true, "title": "Risk grade distribution (A1=highest, D=lowest)"}
            }
          },
          "position": {"x": 0, "y": 9, "width": 4, "height": 6}
        },
        {
          "widget": {
            "name": "score_dist",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_score_dist",
                  "fields": [
                    {"name": "score_bucket", "expression": "`score_bucket`"},
                    {"name": "n", "expression": "`n`"},
                    {"name": "sample_flag", "expression": "`sample_flag`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "score_bucket", "scale": {"type": "quantitative"}, "displayName": "Credit score bucket"},
                "y": {"fieldName": "n", "scale": {"type": "quantitative"}, "displayName": "Applications"},
                "color": {"fieldName": "sample_flag", "scale": {"type": "categorical"}, "displayName": "Sample"}
              },
              "frame": {"showTitle": true, "title": "Credit score distribution by sample_flag"}
            }
          },
          "position": {"x": 4, "y": 9, "width": 4, "height": 6}
        },
        {
