                  {"fieldName": "weighted_gini_by_dp3", "displayName": "Weighted Gini (DP3)"},
                  {"fieldName": "weighted_gini_by_pop", "displayName": "Weighted Gini (pop)"},
                  {"fieldName": "sas_correlation", "displayName": "SAS correlation"},
                  {"fieldName": "comparison_result", "displayName": "Result"}
